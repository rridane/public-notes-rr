---
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: cluster-example
  # Limitation importante : CloudNativePG ne propage pas automatiquement la suppression des labels ou annotations.
  # Ainsi, lorsqu’un label ou une annotation est supprimé du cluster, il reste présent sur les ressources déjà créées et n’est pas retiré automatiquement.
  annotations:
    categories: database
    # Le fencing dans CloudNativePG est le mécanisme ultime de protection des données d’une ou plusieurs instances d’un cluster PostgreSQL lorsqu’elles présentent un dysfonctionnement.
    # Lorsqu’une instance est "fencée" (isolée) :
    #  le processus PostgreSQL (postmaster) est forcé à s’arrêter,
    #  mais le pod reste en exécution.
    # Cela garantit qu’aucune modification ne sera apportée aux données tant que le fence n’est pas levé,
    # tout en permettant d’inspecter le système de fichiers pour le debug et le troubleshooting.
    # '["*"]' pour isoler toutes les instances
    # Si une instance primaire est isolée, son processus PostgreSQL est arrêté sans déclencher de failover.
    # Les applications perdent alors l’accès à la base tant que le fence n’est pas levé.
    cnpg.io/fencedInstances: '["cluster-example-1"]'
  labels:
    environment: production
    workload: database
    app: sso
spec:
  instances: 3
  imageCatalogRef:
    apiGroup: postgresql.cnpg.io
    kind: ClusterImageCatalog
    name: postgresql
    major: 16
  storage:
    size: 1Gi
    storageClass: fastest
    # il est également possible de fournir un pvc template comme ci dessous
    pvcTemplate:
      accessModes:
        - ReadWriteOnce
      resources:
        requests:
          storage: 1Gi
      storageClassName: standard
      volumeMode: Filesystem
  walStorage:
    size: 10Gi
    storageClass: fastest
  # activée, l’opérateur utilise le Secret SuperuserSecret pour mettre à jour mot de passe de l’utilisateur postgres (si secret n’existe pas, il en crée un).
  # désactivée, l’opérateur ignore le contenu du SuperuserSecret, le supprime s’il l’avait créé automatiquement, et efface le mot de passe de l’utilisateur postgres en le définissant à NULL.
  # désactvé par défaut
  enableSuperuserAccess: false # false by default
  enableSuperuserSecret: null # null by default
  # Bootstrap
  bootstrap:
    # initDB : initialiser à vide avec une base app, son ower app qui peut s'identifier avec les secrets
    initdb:
      # new database specifing specs
      database: app
      owner: app
      # si non fournit un secret basic-auth <cluster-name>-app est créé
      secret:
        name: app-secret # sous la forme username / password
      # new database from existing base
      # Copie logique au contraire de pg_basebackup
      # Toutes versions, mais ne copie pas wal et fichiers internes, roles et acl, et extensions à recréer
      import:
        # on base = microservice (non consillé) (roles non importés)
        #  postImportApplicationSQL supporté.
        type: microservice
        databases:
          - angus
        # type monotith (possibles d'importer les roles)
        # possible d'utiliser * pour importer tout
        #  postImportApplicationSQL non supporté.
        type: monolith
        databases:
          - accounting
          - banking
          - resort
        roles:
          - accountant
          - bank_user
        # options non validées par l'opérateur donc à tester
        pgDumpExtraOptions:
          - '--jobs=2'
        pgRestoreExtraOptions:
          - '--jobs=2'
        source:
          externalCluster: cluster-pg96
      dataChecksums: true          # active les checksums
      encoding: 'LATIN1'           # encodage par défaut
      locale: 'fr_FR.UTF-8'        # locale par défaut
      localeCollate: 'fr_FR.UTF-8' # ordre de tri
      localeCType: 'fr_FR.UTF-8'   # classification caractères
      localeProvider: icu          # fournisseur ICU (≥15)
      icuLocale: 'fr-FR'           # ICU locale
      icuRules: 'secondary'        # règles ICU (≥16)
      walSegmentSize: 32           # taille WAL (MB)
      postInitSQL:
        - CREATE DATABASE analytics;
        # voir roles crées via section roles (managed.roles)
        - |
          GRANT CONNECT ON DATABASE appdb TO dante;
          GRANT USAGE ON SCHEMA public TO readonly;
          GRANT SELECT ON ALL TABLES IN SCHEMA public TO readonly;
          GRANT INSERT, UPDATE ON ALL TABLES IN SCHEMA public TO readwrite;
      postInitApplicationSQLRefs:
        secretRefs:
          - name: init-queries-secret
            key: init.sql
        configMapRefs:
          - name: init-queries-cm
            key: init.sql
    # à partir  d'un recovery
    #

    # Sous le capot, CNPG :
    #  injecte un init container dans le premier pod ;
    # utilise barman-cloud-restore pour restaurer la base backup ;
    #  lance PostgreSQL en mode recovery ;
    #  utilise restore_command + barman-cloud-wal-restore pour rejouer les WAL (avec parallélisme possible via maxParallel) ;
    #  arrête la recovery au dernier WAL ou à la cible PITR ;
    #  applique les secrets et démarre le cluster normalement.
    #  Le processus est entièrement orchestré par l’opérateur et l’instance manager.
    recovery:
      # recovery depuis un external cluster (souvent via un backup object store)
      source: source-prod
      # il est aussi possible d'utiliser directement la ressource backup associée
      backup:
        name: backup-example
      # s'arrêter à une targettime bien précise
      recoveryTarget:
        targetTime: "2025-09-20 14:30:00+00"
      # cpng permets de configurer la base applicative
      # À la fin du recovery, l’opérateur garantit que:
      #  si la base n’existe pas → elle est créée ;
      #  si l’utilisateur n’existe pas → il est créé ;
      #  si l’utilisateur n’est pas propriétaire → il le devient ;
      #  si le mot de passe dans le secret diffère → il est mis à jour.
      database: app
      owner: app
      secret:
        name: app-secret
    # à partir d'un backup de cngp va faire lui meme
    # Copie physique (« block-level / file level ») du cluster source (même version majeure requise, même architecture, etc.),
    # va copier l’ensemble du répertoire de données (data directory), y compris les WAL, les tablespaces, et toutes les extensions, sans passer par pg_dump.
    # Nécessite même version majeure
    pg_basebackup:
      source: source-db
  # external clusters
  externalClusters:
    - name: source-prod
      plugin:
        name: barman-cloud.cloudnative-pg.io
        parameters:
          barmanObjectName: backup-pg-object-store
          serverName: cluster-example
    # à partir d'un backup de la base avec bootstrap.pb_basebackup
    - name: source-db
      connectionParameters:
        host: source-db.foo.com
        user: streaming_replica
      password:
        name: source-db-replica-user
        key: password
  # probes (defaut values)
  probes:
    startup:
      periodSeconds: 3
      timeoutSeconds: 3
      failureThreshold: 10
      # succès quand le réplica commence à streamer et respecte maximumLag.
      type: streaming
      maximumLag: 16Mi
      # succès si une requête simple sur postgres s’exécute.
      type: query
      #  succès quand pg_isready=0.
      type: pg_isready
    liveness:
      periodSeconds: 3
      timeoutSeconds: 3
      failureThreshold: 10
      # isolationCheck : un primaire est arrêté si:
      # 1. il ne peut plus joindre l’API Server Kubernetes,
      # 2. ET aucune autre instance via l’API REST interne.
      isolationCheck:
        enabled: true
        requestTimeout: "2000"
        connectionTimeout: "2000"
    readiness:
      periodSeconds: 3
      timeoutSeconds: 3
      failureThreshold: 10
      # succès quand le réplica commence à streamer et respecte maximumLag.
      type: streaming
      maximumLag: 16Mi
      # succès si une requête simple sur postgres s’exécute.
      type: query
      #  succès quand pg_isready=0.
      type: pg_isready
  # Quand un Pod est supprimé (drain ou manuel), kubelet envoie un signal à l’instance manager.
  # Smart shutdown (jusqu’à smartShutdownTimeout) : refuse nouvelles connexions.
  smartShutDownTimeout: 180s
  #Fast shutdown : coupe connexions restantes et attend jusqu’à stopDelay si WAL en cours.
  stopDelay: 1800s
  # Lors d’un switchover → l’ancien primaire doit faire un fast shutdown avant promotion.
  # ⚠️ Bas = favorise RTO mais risque perte (RPO).
  # ⚠️ Haut = évite perte mais cluster sans primaire plus longtemps.
  switchoverDelay: 3600s
  # permet de retarder le déclenchement du failover après détection d’un primaire défaillant. (Attendre le retour du primaire pendant ..)
  failoverDelay: 30s
  affinity:
    nodeSelector:
      node-role.kubernetes.io/postgres: ""
  # ressources de chaque pod
  resources:
    requests:
      memory: "32Mi"
      cpu: "50m"
    limits:
      memory: "128Mi"
      cpu: "100m"
  # Stratégie par défaut de mises à jour mineures.
  # 1 mise à jour des replicas
  # Une fois les réplicas à jour → mise à jour du primaire avec primaryUpdateMethod:
  # restart (défaut) : redémarrage auto du Pod primaire. Si impossible → bascule (switchover).
  # switchover : promotion auto du standby le plus avancé, arrêt de l’ancien primaire.
  primaryUpdateStrategy: unsupervised
  #  L’opérateur met à jour les réplicas puis suspend le processus.
  # L’admin doit déclencher manuellement :
  # Bascule vers un standby comme nouveau primaire
  # kubectl cnpg promote <cluster> <new_primary>
  # Restart du primaire actuel
  # kubectl cnpg restart <cluster> <current_primary>
  primaryUpdateStrategy: supervised
  # la conf de roles ci dessous équivaut à
  # L'exemple ci dessous crée quatre rôles (readonly, readwrite, dante), définit leur hiérarchie et applique les permissions après le bootstrap (voir boostrap.postInitSQL)
  managed:
    # role = group et user
    # sans password à l'initialisation, le role n'a pas de mot de passe
    # pour suppirmer le mto de passe existant il faut utilsier disablePassword: true
    roles:
      - name: readonly
        ensure: present
      - name: readwrite
        ensure: present
        inRoles:
          - readonly # (héritage, donc donne également le role readonly)
      - name: dante
        ensure: present
        login: true
        comment: Dante Alighieri
        superuser: false
        # secret pour les credentials basé les clés sur username/password
        passwordSecret:
          name: dante-password
        inRoles:
          - readwrite # (héritage, donc donne également le role readwrite)
          - pg_monitor
          - pg_signal_backend
  # Il existe trois fichiers principaux pour configurer une instance:
  # La configuration s’effectue via la section postgresql de la ressource Cluster, en définissant les paramètres des fichiers postgresql.conf, pg_hba.conf et pg_ident.conf à l’aide des clés parameters, pg_hba et pg_ident.
  # Il n'est pas possible de faire autrement
  postgresql:
    #  postgresql.conf: le fichier principal de configuration à l’exécution de PostgreSQL ;
    parameters:
      shared_buffers: "1GB"
      # paramètre spécifique à auto_explain quand l'extension est activée (impact sur les perfs)
      auto_explain:
        # enregistre automatiquement les plan de requêtes de plus de 10s
        log_min_duration: "10s"
      # paramètres spécifiques à pg_stat_statements
      pg_stat_statements:
        max: "10000"
        track: "all"
      # paramètres spécifiques à pgaudit
      # les journaux d'audit générés par PGAUDIT sont eux envoyés vers la stdout comme les autres au format json (logger=pgaudit, msg=record, record=<rengistrementcompletjson>, record.audit<messagepgaudit>)
      pgaudit:
        log: "all, -misc"
        log_catalog: "off"
        log_parameter: "on"
        log_relation: "on"
      # L’extension pg_failover_slots, développée par EDB, garantit que les replication slots logiques survivent à un basculement.
      # pg_failover_slots:

    # pg_hba.conf: le fichier d’authentification des clients ;
    # liste des règles d’authentification (Host Based Authentication) utilisées pour générer le fichier pg_hba.conf
    pg_hba:
      # règle par défaut
      - host all all all <default-authentication-method>
      # paramètre à activer pour chaque base ou l'on souhaite utiliser pg_failover_slots
      - hostssl app streaming_replica all cert
      # on autorise l’utilisateur app à accéder à la base app depuis le réseau 10.244.0.0/16 via une connexion SSL, avec une authentification par mot de passe MD5 (ou scram-sha-256)
      - hostssl app app 10.244.0.0/16 md5
    #  pg_ident.conf: le fichier permettant d’associer des utilisateurs externes à des utilisateurs internes.
    pg_ident:
    # Le paramètre shared_preload_libraries dans PostgreSQL permet de définir une ou plusieurs bibliothèques partagées à précharger au démarrage du serveur, sous la forme d’une liste séparée par des virgules.
    # Il est généralement utilisé pour charger des extensions qui doivent être disponibles dans la plupart des sessions de la base (par exemple: pg_stat_statements).
    # Extensions gérées par défaut: auto_explain, pg_stat_statements, pgaudit, pg_failover_slots
    # CloudNativePG gère automatiquement la création et la suppression de l’extension dans toutes les bases de données accessibles du cluster pour ces extensions (create extension géré automatiquement)
    shared_preload_libraries:
      - 'pg_stat_statements'
      - 'auto_explain'

    # A propos de la replication
    # A propos des replications slots
    # Slot physique = « Conserve les fichiers WAL tant que mon standby ne les a pas consommés ». (indicateur restart_lsn, position minimal du wal qui doit être conservée)
    # Slot logique = « Conserve les anciennes versions de lignes tant que mon abonné n’a pas consommé les événements correspondants ». (indicateur catalog_xmin)
    # A propos du mode de replication
    # asynchrone : commit confirmé au client dès que le WAL est écrit et flushé sur disque localement, Les standbys reçoivent le flux WAL plus tard (via streaming). => risque perte
    # synchrone: commit confirmé seulement quand le primaire a écrit le WAL et que les standby synchrones désignés ont accusé réception.
    ## Selon la configuration, le standby doit avoir soit reçu (write), soit flushé (flush), soit appliqué (apply) les WAL.
    # Section de configuration de postgres (qui utilisera les notions de replications présentées ci dessus)
    synchronous:
      # Replication synchrone, en first (priorité)
      # Attends que 2 standby confirme avoir traité l'opérartion pour confirmer le commit au client
      # Traité l'opération dépend de la conf : remote_write (a écrit en mémoire), remote_apply (a appliqué la transaction, donc visible en requête)
      # Attention FIRST 2 signifie qu'il attendra confirmation des deux premiers de la liste qui sont ups, ce n'est pas 2 parmi les 3
      # FIRST 2 (angus, cluster-example-2, malcolm)
      method: first
      # Replication synchrone en QUORUM
      # ANY 2 (angus, cluster-example-2, malcolm)
      method: any
      number: 2
      # pods locaux (donc gérés par cnpg inclus au max dans le calcul)
      maxStandbyNamesFromCluster: 1
      # replica externe au cluster cnp ajouté au calcul, ajoute au début de la liste donc prioritaire
      standbyNamesPre:
        - angus
      # replica externe au cluster cnp ajouté au calcul, ajoute à la fin de la liste donc secondaire
      standbyNamesPost:
        - malcolm
      # required: sécurité maximale des données, écritures bloquées si aucun standby dispo (RPO=0).
      # preferred: mode auto-guérison, écritures possibles même si moins de standby que prévu, avec risque de perte en cas de panne du primaire.
      dataDurability: required # default
      dataDurability: preferred
      # CloudNativePG prend en charge le chargement dynamique d’extensions PostgreSQL dans un cluster lors du démarrage des Pods
      # Cette fonctionnalité permet de monter une extension PostgreSQL empaquetée sous forme d’image OCI
      # comme un volume en lecture seule et immuable à l’intérieur d’un pod, à un chemin connu du système de fichiers.
      #

      # L’ajout d’une extension dans CloudNativePG suit les étapes suivantes :
      #  Définir l’image de l’extension dans la ressource Cluster. (Appliquez d’abord l’image, laissez le rollout s’effectuer, puis continuez.)
      #  Ajouter la bibliothèque à shared_preload_libraries si nécessaire.
      #  Déclarer l’extension dans la ressource Database correspondante.
      # Une fois montée, PostgreSQL sera automatiquement configuré avec:
      #  /extensions/foo/share ajouté à extension_control_path
      #  /extensions/foo/lib ajouté à dynamic_library_path
      # pour les images avec plusieurs extensions ou la personnalisation des chemins voir doc
      extensions:
        - name: foo
          # Certaines extensions (comme PostGIS) nécessitent des bibliothèques système supplémentaires
          # CloudNativePG ajoutera alors /extensions/postgis/system à LD_LIBRARY_PATH,
          # permettant à PostgreSQL de charger ces bibliothèques au démarrage.
          ld_library_path:
            - syslib
          image:
            reference: # chemin du registre de l’image de votre extension
  # CloudNativePG crée les PVC pour chaque instance du cluster haute disponibilité et les monte dans les pods correspondants.
  # Ensuite, il crée les tablespaces tbs1, tbs2 et tbs3 sur l’instance primaire à l’aide de la commande CREATE TABLESPACE.
  # C'est ensuite immédiatement disponible à l'utilisation app=# CREATE TABLE fibonacci(num INTEGER) TABLESPACE tbs1;
  # Les noms des tablespaces sur les replicas doivent donc être identiques.
  ## Seule la classe de stockage ou la taille peuvent différer.
  # Limitation : Actuellement, il n’est pas encore possible de supprimer un tablespace d’un cluster CloudNativePG existant.
  tablespaces:
    - name: tbs1
      # par défaut les tablespaces appartiennent à l'utilisateur applicatif app
      owner:
        name: postgres # default app
      storage:
        size: 1Gi
        storageClass: fastest
    - name: tbs2
      storage:
        size: 2Gi
        storageClass: balanced
    - name: tbs3
      # CloudNativePG fournit l’option .spec.tablespaces[*].temporary pour marquer un tablespace comme temporaire et l’ajouter au paramètre PostgreSQL temp_tablespaces.
      temporary: true
      storage:
        size: 2Gi
  # Activer l'archivage des wal via le plugin barman cloud (unique plugin supporté)
  plugins:
    - name: barman-cloud.cloudnative-pg.io
      isWALArchiver: true
      parameters:
        # reference vers l'objectStore
        barmanObjectName: postgresql-object-store
  # CloudNativePG permet de monter des fichiers personnalisés à l’intérieur des pods PostgreSQL via le champ .spec.projectedVolumeTemplate.
  # Cette fonctionnalité est utile pour les extensions ou fonctionnalités PostgreSQL nécessitant des fichiers additionnels (certificats, configurations, etc.).
  projectedVolumeTemplate:
    sources:
      - secret:
          name: sample-secret
          items:
            - key: tls.crt
              path: certificate/tls.crt
            - key: tls.key
              path: certificate/tls.key
  # CloudNativePG utilise également des volumes éphémères pour certaines opérations internes.
  # Par défaut, l’opérateur utilise un volume emptyDir.
  ephemeralVolumesSizeLimit:
    # Shm is the size limit of the shared memory volume (https://pkg.go.dev/k8s.io/apimachinery/pkg/api/resource#Quantity)
    shm: xxxG
    # TemporaryData is the size limit of the temporary data volume (https://pkg.go.dev/k8s.io/apimachinery/pkg/api/resource#Quantity)
    temporaryData: xxxG
  # Il est également possible de le remplacer par un VolumeClaimTemplate, défini dans .spec.ephemeralVolumeSource.
  ephemeralVolumeSource:
    volumeClaimTemplate:
      spec:
        accessModes: [ "ReadWriteOnce" ]
        # Exemple de storageClassName (à adapter à votre cluster)
        storageClassName: "ephemeral-storage-class"
        resources:
          requests:
            storage: 1Gi
  # Lorsqu’un nœud hébergeant l’instance primaire est drainé, un switchover est automatiquement exécuté avant le drain. Une fois l’instance déclassée en réplica, le drain peut se poursuivre.
  # Ceci est du à la fcnctionnalité pod disruption budget
  # Pour les clusters à une seule instance, le switchover n’est pas possible :
  # CloudNativePG empêche donc le drainage du nœud contenant cette instance.
  # Pour les clusters de développement (souvent à instance unique), il est nécessaire de désactiver les Pod Disruption Budgets.
  # Sinon, le nœud hébergeant le cluster ne pourra pas être drainé.
  # Attention false uniquement pour les clusters de dev à une seule instance pour permettre le drain d'un noeud
  enablePDB: false
  # Supprimer l’unique instance PostgreSQL d’un cluster avec reusePVC: false entraînera la perte totale des données.
  #  CloudNativePG empêche donc le drainage du nœud dans ce cas, même en mode maintenance.
  # Deux options sont possibles :
  #   Activer reusePVC et accepter le downtime
  #   Répliquer l’instance sur un autre nœud et effectuer un switchover
  nodeMaintenanceWindow:
    inProgress: true
    reusePVC: true
  # env et envFrom pour configuer des varialbes d'environnements
  env:
    - name: TZ
      value: Australia/Sydney
  envFrom:
    - configMapRef:
        name: config-map-name
    - secretRef:
        name: secret-name
  # configmap pour user defined metrics
  monitoring:
    customQueriesConfigMap:
      - name: example-monitoring
        key: custom-queries
  # chaque entrée de log comprends les champs suivants:
  # level – le niveau de log (info, notice, etc.)
  # ts – l’horodatage (timestamp)
  # logger – le type de log (postgres, pg_controldata, etc.)
  # msg – le message de log ou le mot-clé record si le contenu est en JSON
  # record – l’enregistrement complet, dont la structure dépend du type de logger
  # logging_pod – le nom du pod ayant généré le log
  #
  # niveaux de logs possibles
  # error, warning, info (par défaut), debug et trace.
  logLevel: info

---
# CloudNativePG permet de centraliser la définition des images PostgreSQL via deux types de ressources :
#  ImageCatalog : limité à un namespace
#  ClusterImageCatalog : disponible au niveau global du cluster Kubernetes
apiVersion: postgresql.cnpg.io/v1
kind: ImageCatalog
kind: ClusterImageCatalog
metadata:
  name: postgresql
  # sans namespace pour ClusterImageCatalog
  namespace: default
spec:
  images:
    - major: 15
      image: ghcr.io/cloudnative-pg/postgresql:15.6
    - major: 16
      image: ghcr.io/cloudnative-pg/postgresql:16.8
    - major: 17
      image: ghcr.io/cloudnative-pg/postgresql:17.5
---
# Replication, avec Publication & Subscriptions
# La réplication logique ne réplique pas les séquences entre le publisher et le subscriber
# voir doc pour mettre à jour les séquences une fois subsciber à jour
# Ceci est une replication continue, elle diffère du initdb.import qui lui est un nouveau cluster avec un snapshot à partir de pg_dump
apiVersion: postgresql.cnpg.io/v1
kind: Publication
metadata:
  name: freddie-publisher
spec:
  # a partir du cluster dont le nom est freddie
  cluster:
    name: freddie
  # publie la base app
  dbname: app
  name: publisher
  target:
    # publie toutes les tables
    allTables: true
---
# Replication, avec Publication & Subscriptions
apiVersion: postgresql.cnpg.io/v1
kind: Subscription
metadata:
  name: freddie-to-king-subscription
spec:
  cluster:
    name: king
  # synchronisera la base app
  dbname: app
  name: subscriber
  # utilise le cluster externe freddie
  externalClusterName: freddie
  # et la publication freddie-publisher
  publicationName: freddie-publisher
  # il est aussi possible de référencer un cluster externe (ou base externe)
  # Attention c'est le external cluster de la ressoruce cluster, ne pas ajouter dans la ressource subscription
  # externalClusters:
  #  - name: freddie
  #    connectionParameters:
  #      host: freddie-rw.default.svc
  #      user: postgres
  #      dbname: app
---
# Backup
# Le base backup est une photo complète du cluster à un instant donné.
# Le WAL archive est le film continu de toutes les transactions qui suivent.
# Cold backup : arrêt du serveur, copie brute du répertoire PGDATA.
# Sauvegarde continue : base backup + archivage permanent des WAL.
# RPO (Recovery Point Objective) : Perte de données maximale acceptable
# RPO = 0 → aucune perte (nécessite réplication synchrone stricte).
# RPO = 5 minutes → perte max de 5 minutes de données (WAL archive avec rotation ≤ 5 min).
# RPO = 24h → perte max d’une journée (backup quotidien suffit).
# approche recommandée pour les backups : Barman Cloud Plugin
apiVersion: postgresql.cnpg.io/v1
kind: ScheduledBackup
metadata:
  name: backup-example
spec:
  schedule: "0 0 0 * * *"  # Tous les jours à minuit
  # qui est propriétaire du backup généré pour kubernetes
  # ScheduledBackup génère un objet backup (voir ci dessous)
  # options possibles self (donc le ScheduledBackup), "none" ou cluster
  # ce lien kubernets fait si le backup sera supprimé si son parent (owner) est supprimé
  backupOwnerReference: self
  cluster:
    name: pg-to-backup
  # Créé une sauvegarde dès la création
  immediate: true
  # suspendre temporairement les backups
  suspend: false
  pluginConfiguration:
    name: barman-cloud.cloudnative-pg.io
---
# La gestion de la rétention est confiée aux plugins de backup (ex: Barman Cloud Plugin).
# C'est donc dans sa conf qu'il faut spécifier la durée de rétention
# Les wal sont archivés toutes les 5min, c'est une conf postgres archive_timeout, qu'il n'est pas utile de changer
apiVersion: postgresql.cnpg.io/v1
kind: Backup
metadata:
  name: backup-example
spec:
  # methode par défaut, sinon backup volume mais non supporté par nfs
  method: barmanObjectStore
  cluster:
    name: pg-to-backup
  # backup à partir du standby le plus à jour (default)
  target: "prefer-standby"
  # backup à partir du primaire
  target: "primary"
  pluginConfiguration:
    name: barman-cloud.cloudnative-pg.io
---
apiVersion: barmancloud.cnpg.io/v1
kind: ObjectStore
metadata:
  name: backup-pg-object-store
spec:
  configuration:
    destinationPath: "s3://my-bucket/backups/cluster-example"
    # autres paramètres optionnels :
    wal:
      maxParallel: 8
    data:
      compression: gzip
    retentionPolicy: "30d"
    # etc.
  credentials:
    accessKeyId:
      name: s3-creds
      key: ACCESS_KEY_ID
    secretAccessKey:
      name: s3-creds
      key: ACCESS_SECRET_KEY
---
# CloudNativePG simplifie l’approvisionnement des bases PostgreSQL en créant automatiquement, par défaut, une base applicative nommée app.
# Cloudnative permet aux utilisateurs de définir et de contrôler le cycle de vie des bases PostgreSQL à l’aide de la ressource personnalisée (Custom Resource Definition, ou CRD) Database.
# il ne gère pas le contenu interne des bases (comme les tables, vues, données, etc.), à l’exception des extensions et schémas.
# ce manifeste crée un objet Database nommé cluster-example-one, qui demande la création d’une base de données one appartenant au rôle app, dans le cluster PostgreSQL cluster-example.
# Attention : Le renommage de base n’est pas pris en charge, changer le nom d'une base n'aura aucun effet
# CloudNativePG n’écrase pas les modifications manuelles apportées aux bases.
apiVersion: postgresql.cnpg.io/v1
kind: Database
metadata:
  name: cluster-example-one
spec:
  name: one
  owner: app
  cluster:
    name: cluster-example
  # installer des extensions au niveau database
  extensions:
    - name: bloom
      ensure: present
    # Extension perso ajoutée dans le cluster via fonctionnalité Image Volume Extension
    - name: foo
      version: 1.0
  # Pour supprimer la base deux options, soit ensure : absent soit deleteReclaimPolicy
  ensure: absent
  # ou
  databaseReclaimPolicy: delete
  schemas:
    - name: app
      owner: app
      # optionel mais pour illustrer que l'on peut supprimer par absent
      ensure: present
---
# Monitoring
# CloudNativePG expose des métriques le port 9187, via l’endpoint /metrics, depuis sur le service <cluster>-monitoring.
# Ces métriques sont exécutées dans des transactions atomiques avec le rôle pg_monitor, sous l’utilisateur postgres, et sont configurées via le ConfigMap default-monitoring (modifiable ou extensible avec des ConfigMaps/Secrets personnalisés).
# Les requêtes par défaut collectent les vues standard (pg_stat_database, pg_stat_bgwriter, pg_stat_replication, etc.) et produisent des métriques compatibles avec postgres_exporter.
# TODO : Les bases visées dépendent du mode de bootstrap (souvent app par défaut) et peuvent être redéfinies via target_databases (dans la configmap mais à vérifier)
# Il suffit donc ensuite de créer un podMonitor sur le port 9187 poru surveiller le cluster
apiVersion: monitoring.coreos.com/v1
kind: PodMonitor
metadata:
  name: cluster-example
spec:
  selector:
    matchLabels:
      "cnpg.io/cluster": cluster-example
  podMetricsEndpoints:
    - port: metrics
      # Activer le tls sur le port des metrics
      # Par défaut cloudnative génère 4 certificats
      # <cluster-name>-ca	Le CA racine (clé et certificat ca.crt, ca.key)	Sert à signer tous les certificats internes
      # <cluster-name>-server	Le certificat serveur (signé par le CA ci-dessus)	Utilisé par PostgreSQL et le metrics exporter
      # <cluster-name>-replication	Certificat utilisé entre instances pour la réplication TLS
      # <cluster-name>-client	Certificat client par défaut
      # Il nous faut ainsi passer deux informations cruciales :
      # le certificat publique pour s'assurer que le certificat présenté a été signé par le certificat cluster
      # le serverName, qui doit correspondre à l'un des noms définit dans le certificat
      scheme: https
      tlsConfig:
        ca:
          secret:
            name: <cluster-name>-ca
            key: ca.crt
        serverName: <cluster-name>-rw
---
# Pour surveiller un pooler via Prometheus Operator, active :
apiVersion: monitoring.coreos.com/v1
kind: PodMonitor
metadata:
  name: my-pooler
spec:
  selector:
    matchLabels:
      cnpg.io/poolerName: my-pooler
  podMetricsEndpoints:
    - port: metrics
---
# Exemple de configmap pour définir ses propres metriques
# Chaque requête personnalisée suit la structure de base suivante :
# <MetricName>:
# query: "<SQLQuery>"
# metrics:
#   - <ColumnName>:
#       usage: "<MetricType>"
#       description: "<MetricDescription>"
# <MetricName> : nom logique de la métrique Prometheus.
# name : permet d’écraser <MetricName> si défini.
# query : la requête SQL exécutée sur la base cible pour produire la métrique.
# primary : exécute la requête uniquement sur l’instance primaire.
# master : équivalent historique de primary (supporté pour compatibilité, mais déprécié).
# runonserver : plage de versions PostgreSQL sur lesquelles exécuter la requête (ex. ">=11.0.0" ou ">=12.0.0 ⇐15.0.0").
# target_databases : liste des bases sur lesquelles exécuter la requête, ou motif shell pour activer l’auto-découverte. Remplace la base par défaut si fourni.
# predicate_query : requête SQL renvoyant au plus une ligne et une colonne booléenne ; si le résultat est vrai, la requête principale est exécutée.
# metrics : section listant toutes les colonnes exportées, chacune définie comme :
# <ColumnName> : nom de la colonne retournée.
# name : remplace le nom de la colonne dans la métrique, si défini.
# usage : type d’usage de la colonne (voir tableau ci-dessous).
# description : description lisible de la métrique.
# metrics_mapping : mappage optionnel lorsque usage = MAPPEDMETRIC. ( voir doc pour les valeurs possibles)
# sotrie d'une métrique personnalisée :
#  cnpg_<MetricName>_<ColumnName>{<LabelColumnName>=<LabelColumnValue> ... } <ColumnValue>
apiVersion: v1
kind: ConfigMap
metadata:
  name: example-monitoring
  namespace: test
  labels:
    cnpg.io/reload: ""
data:
  custom-queries: |
    ## L'exemple ci dessous renvoie les résultats ci dessous
    ## HELP cnpg_pg_replication_in_recovery Whether the instance is in recovery
    ## TYPE cnpg_pg_replication_in_recovery gauge
    # cnpg_pg_replication_in_recovery 0
    ## HELP cnpg_pg_replication_lag Replication lag behind primary in seconds
    ## TYPE cnpg_pg_replication_lag gauge
    # cnpg_pg_replication_lag 0
    ## HELP cnpg_pg_replication_streaming_replicas Number of streaming replicas connected to the instance
    ## TYPE cnpg_pg_replication_streaming_replicas gauge
    # cnpg_pg_replication_streaming_replicas 2
    ## HELP cnpg_pg_replication_is_wal_receiver_up Whether the instance wal_receiver is up
    ## TYPE cnpg_pg_replication_is_wal_receiver_up gauge
    # cnpg_pg_replication_is_wal_receiver_up 0
    pg_replication:
      query: "SELECT CASE WHEN NOT pg_is_in_recovery()
              THEN 0
              ELSE GREATEST (0,
                EXTRACT(EPOCH FROM (now() - pg_last_xact_replay_timestamp())))
              END AS lag,
              pg_is_in_recovery() AS in_recovery,
              EXISTS (TABLE pg_stat_wal_receiver) AS is_wal_receiver_up,
              (SELECT count(*) FROM pg_stat_replication) AS streaming_replicas"
      metrics:
        - lag:
            usage: "GAUGE"
            description: "Replication lag behind primary in seconds"
        - in_recovery:
            usage: "GAUGE"
            description: "Whether the instance is in recovery"
        - is_wal_receiver_up:
            usage: "GAUGE"
            description: "Whether the instance wal_receiver is up"
        - streaming_replicas:
            usage: "GAUGE"
            description: "Number of streaming replicas connected to the instance"
    # L’option predicate_query permet d’exécuter la requête collectant les métriques uniquement si certaines conditions sont remplies.
    # Doit retourner au plus une ligne avec une seule colonne booléenne.
    some_query: |
      predicate_query: |
        SELECT
          some_bool as predicate
        FROM some_table
      query: |
        SELECT
         count(*) as rows
        FROM some_table
      metrics:
        - rows:
            usage: "GAUGE"
            description: "number of rows"
    # Controller les bases lorsque target_databases contient plus d'une base
    # Cela produit
    # cnpg_some_query_rows{datname="albert"} 2
    # cnpg_some_query_rows{datname="bb"} 5
    # cnpg_some_query_rows{datname="freddie"} 10
    # cnpg_some_query_rows{datname="template1"} 7
    # cnpg_some_query_rows{datname="postgres"} 42
    some_query_2: |
      query: |
        SELECT
         current_database() as datname,
         count(*) as rows
        FROM some_table
      metrics:
        - datname:
            usage: "LABEL"
            description: "Name of current database"
        - rows:
            usage: "GAUGE"
            description: "number of rows"
      target_databases:
        - albert
        - bb
        - freddie
    # comprendre les labels (ici
    # cnpg_connections{datname="app",state="active"} 10
    some_query_3: |
      query: |
        SELECT
          current_database() as datname,
          state,
          COUNT(*) as connections
        FROM pg_stat_activity
        GROUP BY datname, state
      metrics:
        - datname:
            usage: "LABEL"
        - state:
            usage: "LABEL"
        - connections:
            usage: "GAUGE"
---
# CloudNativePG fournit une prise en charge native de PgBouncer, l’un des poolers de connexions PostgreSQL
# Un pooler dans CloudNativePG correspond à un déploiement de pods PgBouncer
# situé entre vos applications et un service PostgreSQL (par exemple le service rw).
# Les applications ne se connectent plus directement au service primaire PostgreSQL (rw)
# Ce mécanisme permet :
#    la réutilisation des connexions existantes
#    une réduction du coût des connexions côté PostgreSQL
#    une meilleure répartition de charge et des performances accrues
# Cet exemple crée une ressource Pooler appelée pooler-example-rw,
# liée au cluster PostgreSQL cluster-example et pointant vers le service RW (cluster-example-rw).
# poolMode: session
# max_client_conn: 1000
# default_pool_size: 10
apiVersion: postgresql.cnpg.io/v1
kind: Pooler
metadata:
  name: pooler-example-rw
spec:
  cluster:
    name: cluster-example
  instances: 3
  type: rw
  # L’opérateur gère la plupart des options PgBouncer, mais permet d’en surcharger certaines via :
  pgbouncer:
    poolMode: session
    parameters:
      max_client_conn: "1000"
      default_pool_size: "10"
      query_timeout: "300"
  # Le Pooler peut définir un serviceTemplate pour ajuster les labels, annotations, ou le type du service exposé:
  serviceTemplate:
    metadata:
      labels:
        app: pooler
    spec:
      type: LoadBalancer
---
[source,bash]
----
# Afficher le statut d’un cluster PostgreSQL
kubectl cnpg status my-cluster [-v|-v|-v] [--color=never] [--output yaml|json]

# Promouvoir une instance en primaire
kubectl cnpg promote my-cluster my-cluster-2

# Générer un certificat utilisateur pour un cluster
kubectl cnpg certificate my-cert --cnpg-cluster my-cluster --cnpg-user myuser

# Redémarrer un cluster complet ou une seule instance
kubectl cnpg restart my-cluster
kubectl cnpg restart my-cluster my-cluster-2

# Recharger la configuration (ConfigMaps/Secrets modifiés)
kubectl cnpg reload my-cluster

# Activer ou désactiver le mode maintenance
kubectl cnpg maintenance set --all-namespaces [--reusePVC]
kubectl cnpg maintenance unset --all-namespaces

# Générer un rapport pour diagnostic opérateur
kubectl cnpg report operator -n cnpg-system [-f report.zip] [--logs] [-S]

# Générer un rapport pour diagnostic cluster
kubectl cnpg report cluster my-cluster -n my-ns [--logs] [-f report.zip]

# Récupérer les logs de tous les pods d’un cluster
kubectl cnpg logs cluster my-cluster [-f|--follow] [--tail 100] [--output logs.txt]

# Formater les logs en sortie lisible (triée par timestamp)
kubectl cnpg logs cluster my-cluster | kubectl cnpg logs pretty [--pods <pod>] [--loggers <logger>] [--log-level info]

# Supprimer une instance et ses PVC
kubectl cnpg destroy my-cluster my-cluster-2 [--keep-pvc]

# Mettre un cluster en hibernation / reprise
kubectl cnpg hibernate on my-cluster
kubectl cnpg hibernate off my-cluster

# Lancer un benchmark PostgreSQL
kubectl cnpg pgbench my-cluster -- --time 30 --client 1 --jobs 1

# Lancer un benchmark de stockage
kubectl cnpg fio my-fio-job [-n namespace]

# Demander un nouveau backup physique
kubectl cnpg backup my-cluster [-m volumeSnapshot] [--online] [--immediate-checkpoint]

# Accéder au shell psql d’un cluster (connexion postgres)
kubectl cnpg psql my-cluster [--replica]

# Installer pgAdmin4 (démo ou local uniquement)
kubectl cnpg pgadmin4 my-cluster [--mode desktop|server] [--dry-run]

# Créer une publication de réplication logique
kubectl cnpg publication create my-cluster \
--publication app --all-tables \
[--external-cluster source-cluster]

# Supprimer une publication
kubectl cnpg publication drop my-cluster --publication app

# Créer une souscription de réplication logique
kubectl cnpg subscription create dest-cluster \
--external-cluster source-cluster \
--publication app --subscription app

# Synchroniser les séquences d’une souscription logique
kubectl cnpg subscription sync-sequences dest-cluster --subscription app

# Supprimer une souscription
kubectl cnpg subscription drop dest-cluster --subscription app

# K9s : un plugin kubectl-cnpg peut être intégré directement via k9s/plugins.yml.
----
